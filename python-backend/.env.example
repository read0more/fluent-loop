# TTS Provider Configuration
# TTS Engine Selection: edge-tts (free) or supertonic (paid)
TTS_PROVIDER=edge-tts

# Edge TTS Configuration
TTS_VOICE=en-US-AriaNeural

# Supertonic TTS Configuration (required when TTS_PROVIDER=supertonic)
SUPERTONIC_API_KEY=your_api_key_here
SUPERTONIC_VOICE=en-us-1
SUPERTONIC_BASE_URL=https://api.supertonic.ai/v1

# Whisper STT Configuration
WHISPER_MODEL=base
USE_GPU=false

# Server Configuration
PORT=8000
LOG_LEVEL=info
