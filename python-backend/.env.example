# TTS Provider Configuration
# TTS Engine Selection: edge-tts(default) or supertonic
TTS_PROVIDER=edge-tts

# Supertonic TTS Configuration
SUPERTONIC_VOICE=M4

# Edge TTS Configuration (used when TTS_PROVIDER=edge-tts)
EDGE_TTS_VOICE=en-US-AriaNeural

# Whisper STT Configuration
WHISPER_MODEL=base # Larger models improve accuracy but reduce speed.
STT_USE_GPU=false # Improves STT speed, but only NVIDIA GPUs are supported.

# Server Configuration
PORT=8000  # If changed, update BACKEND_URL in root .env accordingly
LOG_LEVEL=info
