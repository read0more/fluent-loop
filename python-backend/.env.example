# TTS Provider Configuration
# TTS Engine Selection: edge-tts or supertonic(default)
TTS_PROVIDER=supertonic

# Supertonic TTS Configuration
SUPERTONIC_VOICE=M4

# Edge TTS Configuration (used when TTS_PROVIDER=edge-tts)
EDGE_TTS_VOICE=en-US-AriaNeural

# Whisper STT Configuration
WHISPER_MODEL=small
STT_USE_GPU=false # STT의 속도는 빨라지나 NVIDIA만 지원됨.

# Server Configuration
PORT=8000  # Do not change - Electron frontend is hardcoded to call port 8000
LOG_LEVEL=info
